@{ var english=Context.Request.Cookies["droosy-language"]=="en"; var screen=Model as DemoPage??ViewData["Page"] as DemoPage; var inside=screen?.Account!=null&&ViewContext.RouteData.Values["action"]?.ToString()!="Index"; var title=ViewData["Title"] as string??screen?.Title??"دروسي"; var section=screen?.Section??"home"; }
<!DOCTYPE html>
<html lang="@(english?"en":"ar")" dir="@(english?"ltr":"rtl")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#0e5a46"/><meta name="droosy-generation" content="@(Context.RequestServices.GetRequiredService<Droosy_DAL.Data.DemoScope>().GenerationId)"/><title>@title | دروسي</title><link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true"/><link rel="icon" href="~/favicon-32.png" type="image/png" sizes="32x32" asp-append-version="true"/><link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><div class="app-shell">
<header class="topbar"><a class="brand" href="/Demo"><span class="brand-mark">د</span><span>دروسي<small>DROOSY</small></span></a><div class="header-actions"><partial name="_LanguageToggle" />@if(inside){<a class="notification-bell" href="/Demo/Notifications" aria-label="الإشعارات"><svg class="icon" aria-hidden="true"><use href="/icons.svg#bell"></use></svg>@if(screen!.Notifications.Any(x=>x.ReadAtUtc==null)){<span>@screen.Notifications.Count(x=>x.ReadAtUtc==null)</span>}</a>}else{<span class="demo-label"><i></i> تجربة مستقلة لك</span>}</div></header>
@if(inside)
{
 <div class="demo-strip"><span>@(screen!.IsTeacher?"حساب المدرس":screen.IsParent?"حساب ولي الأمر":"حساب الطالب")</span><a href="/Demo">تبديل الدور ⇄</a></div>
 <div class="page-heading"><div><p class="eyebrow">معك في رحلة التعلم</p><h1>@title</h1><p>@screen.Subtitle</p></div><button type="button" class="help-button" data-show-hints aria-label="إظهار شرح الصفحة">؟</button></div>
 @if(screen.IsParent){<div class="child-tabs" aria-label="اختيار الابن">@foreach(var child in screen.Students){<form asp-antiforgery="false" asp-action="Child" method="post"><input type="hidden" name="section" value="@screen.Section"/><input type="hidden" name="studentId" value="@child.Id"/><button type="submit" class="@(screen.Student?.Id==child.Id?"selected":"")"><span class="avatar">@child.DisplayName[..1]</span>@child.DisplayName.Split(' ')[0]</button></form>}</div>}
}
<main id="main">@if(TempData["Success"] is string success){<div class="toast" role="status">✓ @success<button data-dismiss type="button" aria-label="إغلاق">×</button></div>}@if(TempData["Error"] is string error){<div class="toast error-toast" role="alert">@error<button data-dismiss type="button" aria-label="إغلاق">×</button></div>}@RenderBody()</main>
@if(inside)
{
 var tasks=section is "assignments" or "exams" or "review";
 <nav class="bottom-nav" aria-label="التنقل الرئيسي"><a class="@(section=="home"?"active":"")" href="/Demo/Dashboard"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#home"></use></svg></span>الرئيسية</a>
 @if(screen!.IsTeacher){<a class="@(section is "groups" or "attendance"?"active":"")" href="/Demo/Dashboard?section=groups"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#users"></use></svg></span>المجموعات</a><a class="@(tasks?"active":"")" href="/Demo/Assignments"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#clipboard"></use></svg></span>المهام</a>}
 else if(screen.IsParent){<a class="@(section is "attendance" or "progress"?"active":"")" href="/Demo/Attendance"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#calendar"></use></svg></span>المتابعة</a><a class="@(section is "results" or "exams"?"active":"")" href="/Demo/Results"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#chart"></use></svg></span>النتائج</a>}
 else{<a class="@(section is "courses" or "progress"?"active":"")" href="/Demo/Dashboard?section=courses"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#book"></use></svg></span>كورساتي</a><a class="@(tasks?"active":"")" href="/Demo/Assignments"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#clipboard"></use></svg></span>المهام</a>}
 <a class="@(section=="more"?"active":"")" href="/Demo/Dashboard?section=more"><span class="nav-icon"><svg class="icon"><use href="/icons.svg#more"></use></svg></span>المزيد</a></nav>
}
<footer class="footnote">دروسي · نتعلم، نتابع، ونكبر معًا</footer></div><script src="~/js/translations.en.js" asp-append-version="true" defer></script><script src="~/js/language.js" asp-append-version="true" defer></script><script src="~/js/site.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

