@model AttendanceEditorModel
@{ var session = Model.Session; var future = session.EndsAtUtc > DateTime.UtcNow; var changed = session.IsApproved && session.Attendances.Any(x => x.Status != x.PublishedStatus || x.Note != x.PublishedNote); }
<a class="back-link" href="/Demo/Attendance">→ الحصص والحضور</a>
<section class="card session-hero"><div class="card-top"><span class="eyebrow">@session.Group.Name</span><span class="badge @(session.IsApproved ? "" : "amber")">@(session.IsApproved ? "معتمدة" : future ? "قادمة" : "مسودة")</span></div><h2>@session.Title</h2><p>@DemoPage.DateAndTime(session.StartsAtUtc)</p><small class="muted">بتوقيت القاهرة · @Model.Entries.Count طلاب</small></section>
@if (future) { <div class="empty-state"><h2>الحصة لسه ما انتهتش</h2><p>تسجيل الحضور يصبح متاحًا بعد انتهاء الحصة. لم ننشئ سجلات حضور للطلاب.</p></div> }
else
{
    <div class="coachmark" data-hint="register" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>@(session.IsApproved ? "تعديلك يظل مسودة حتى تضغط اعتماد الحضور. عند الاعتماد تُحدث متابعة الأهل، ونسجل الحالة قبل وبعد التصحيح." : "اختَر حالة كل طالب، ثم اعتمد الحضور ليظهر لولي الأمر. يمكنك حفظ المسودة والرجوع لها لاحقًا.")</div>
    @if (changed) { <div class="draft-notice">لديك تعديلات لم تُعتمد. ولي الأمر يرى آخر نسخة معتمدة.</div> }
    <form asp-antiforgery="false" asp-action="SaveAttendance" method="post" class="attendance-form"><input type="hidden" asp-for="SessionId" /><div asp-validation-summary="All" class="validation" role="alert"></div>
    @for (var i = 0; i < Model.Entries.Count; i++)
    {
        <article class="student-register card"><input type="hidden" asp-for="Entries[i].StudentId" /><div class="student-register-heading"><span class="avatar">@Model.Entries[i].StudentName[..1]</span><div><h2>@Model.Entries[i].StudentName</h2><small>اختر حالة الحضور</small></div></div><fieldset class="attendance-options"><legend class="sr-only">حضور @Model.Entries[i].StudentName</legend>
        @foreach (var status in Enum.GetValues<AttendanceStatus>()) { <label><input type="radio" asp-for="Entries[i].Status" value="@status" required /><span class="@TrackingDisplay.Tone(status)">@TrackingDisplay.Status(status)</span></label> }
        </fieldset><label class="register-note">ملاحظة لولي الأمر <small>اختياري</small><textarea asp-for="Entries[i].Note" maxlength="300" rows="2" placeholder="ملاحظة قصيرة عن الحصة..."></textarea></label></article>
    }
    <div class="register-actions"><div class="coachmark" data-hint="approve" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>اعتماد الحضور ينشر حالة جميع طلاب الحصة عند الأهل. حفظ المسودة يحتفظ بتعديلاتك فقط.</div><button type="submit" name="intent" value="approve" class="button full">اعتماد الحضور</button><button type="submit" name="intent" value="draft" class="button secondary full">حفظ المسودة</button></div></form>
}
@if (Model.History.Any()) { <div class="section-title"><h2>سجل الاعتماد والتصحيح</h2></div><div class="audit-timeline">@foreach (var item in Model.History) { <details class="card"><summary><strong>@(item.Action == "CorrectAttendance" ? "تصحيح حضور معتمد" : "اعتماد الحضور")</strong><small>@DemoPage.DateAndTime(item.CreatedAtUtc)</small></summary><div class="audit-values">@{var before = System.Text.Json.JsonSerializer.Deserialize<List<AttendanceSnapshot>>(item.BeforeJson) ?? [];var after = System.Text.Json.JsonSerializer.Deserialize<List<AttendanceSnapshot>>(item.AfterJson) ?? [];}@foreach(var change in after){var previous=before.SingleOrDefault(x=>x.StudentId==change.StudentId);<div class="audit-change"><strong>@Model.Entries.FirstOrDefault(x=>x.StudentId==change.StudentId)?.StudentName</strong><p>@TrackingDisplay.Status(previous?.Status) ← @TrackingDisplay.Status(change.Status)</p>@if(previous?.Note!=change.Note){<small>الملاحظة السابقة: @(string.IsNullOrEmpty(previous?.Note)?"بدون ملاحظة":previous.Note)</small><small>الملاحظة الجديدة: @(string.IsNullOrEmpty(change.Note)?"بدون ملاحظة":change.Note)</small>}</div>}</div></details> }</div> }
