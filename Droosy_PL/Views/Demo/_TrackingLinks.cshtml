@model DemoPage
<div class="quick-links @(!Model.IsTeacher && !Model.IsParent?"single-shortcut":"")"><a class="quick-link" href="/Demo/Attendance"><svg class="icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg><strong>@(Model.IsTeacher ? "الحصص والحضور" : "الحضور والغياب")</strong><small>@(Model.IsTeacher ? "سجل واعتمد حضور طلابك" : "كل حصة بحالتها المعتمدة")</small></a>@if(Model.IsTeacher || Model.IsParent){<a class="quick-link" href="/Demo/Progress"><svg class="icon" aria-hidden="true"><use href="/icons.svg#book"></use></svg><strong>@(Model.IsTeacher ? "تقدم الطلاب" : Model.IsParent ? "متابعة الدروس" : "رحلتي في التعلم")</strong><small>المكتمل وآخر نشاط تعليمي</small></a>}</div>
@if (!Model.IsTeacher)
{
    var latest = Model.Sessions.Where(x => x.IsApproved).OrderByDescending(x => x.StartsAtUtc).FirstOrDefault();
    var register = latest?.Attendances.SingleOrDefault(x => x.StudentId == Model.Student?.Id);
    @if (latest != null && register != null)
    {
        <a class="card home-attendance" href="/Demo/Session/@latest.Id"><div class="card-top"><span class="eyebrow">آخر حضور معتمد</span><span class="badge @TrackingDisplay.Tone(register.PublishedStatus)">@TrackingDisplay.Status(register.PublishedStatus)</span></div><h2>@latest.Title</h2><p>@DemoPage.DateAndTime(latest.StartsAtUtc)</p><span class="text-button">تفاصيل الحصة ←</span></a>
    }
}
