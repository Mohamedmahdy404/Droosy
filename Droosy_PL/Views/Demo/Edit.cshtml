@model EditLessonModel
<a class="back-link" href="/Demo/Course/@Model.CourseId">→ العودة للكورس</a><div class="intro-note">خلّي الخطوة القادمة أوضح لطلابك. تعديلاتك تتحفظ في نفس الكورس.</div><form asp-action="Edit" method="post" class="edit-form card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation" role="alert"></div><div class="field"><label asp-for="Title">عنوان الدرس</label><input asp-for="Title" minlength="3" maxlength="160" required autocomplete="off"/></div><div class="field"><label asp-for="Description">وصف الدرس</label><textarea asp-for="Description" rows="5" maxlength="2000" required></textarea><small>اشرح للطالب الفكرة التي سيتعلمها.</small></div><div class="field"><label asp-for="Status">حالة النشر</label><select asp-for="Status" id="publication-status"><option value="Draft">مسودة — ظاهرة للمدرس فقط</option><option value="Published">منشور — يظهر للطلاب</option><option value="Scheduled">مجدول — يظهر في موعد تحدده</option></select></div><div class="field" id="schedule-field"><label asp-for="PublishAtLocal">موعد النشر بتوقيت القاهرة</label><input asp-for="PublishAtLocal" type="datetime-local"/><small>الموعد بتوقيت القاهرة.</small></div><label class="check-field"><input asp-for="IsPreview"/><span><strong>معاينة مجانية</strong><small>يسمح بفتح الدرس بدون اشتراك نشط.</small></span></label><div class="hint-target"><div class="coachmark" data-hint="save" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>حفظ التعديلات يحدّث الدرس فعليًا. اختيار «منشور» يظهره للطالب وولي الأمر.</div><button class="button full" type="submit">حفظ تعديلات الدرس ✓</button></div><a class="cancel-link" href="/Demo/Course/@Model.CourseId">إلغاء والعودة للكورس</a></form>
