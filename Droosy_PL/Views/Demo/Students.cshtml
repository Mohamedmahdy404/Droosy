@model DemoPage
@{var detail=ViewData["StudentDetail"] as bool?==true;}
@if(!detail){@foreach(var student in Model.Students){var group=Model.Groups.Single(x=>x.Students.Any(s=>s.StudentId==student.Id));<a class="list-card" href="/Demo/Students/@student.Id"><span class="avatar">@student.DisplayName[..1]</span><span><strong>@student.DisplayName</strong><small>@group.Name</small></span><span class="chevron">‹</span></a>}}
else
{
 <a class="back-link" href="/Demo/Students">→ كل الطلاب</a><section class="card profile-card"><span class="avatar large">@Model.Student!.DisplayName[..1]</span><h2>@Model.Student.DisplayName</h2><p>@string.Join(" · ",Model.Courses.Select(x=>x.Title))</p></section><div class="quick-links"><a class="quick-link" href="/Demo/Progress?studentId=@Model.Student.Id"><strong>التقدم في الدروس</strong><small>@Model.ProgressRows.Count(x=>x.IsCompleted) دروس مكتملة</small></a><a class="quick-link" href="/Demo/Results?studentId=@Model.Student.Id"><strong>النتائج</strong><small>@Model.Attempts.Count(x=>x.PublishedAtUtc!=null) نتائج منشورة</small></a></div><div class="section-title"><h2>آخر الحصص المعتمدة</h2></div>@foreach(var session in Model.Sessions.Where(x=>x.IsApproved&&x.Attendances.Any(a=>a.StudentId==Model.Student.Id)).OrderByDescending(x=>x.StartsAtUtc).Take(4)){var row=session.Attendances.Single(x=>x.StudentId==Model.Student.Id);<a class="list-card" href="/Demo/Session/@session.Id"><span><strong>@session.Title</strong><small>@DemoPage.DateAndTime(session.StartsAtUtc)</small></span><span class="badge @TrackingDisplay.Tone(row.PublishedStatus)">@TrackingDisplay.Status(row.PublishedStatus)</span></a>}
 <div class="section-title"><h2>الواجبات</h2></div>@foreach(var assignment in Model.Assignments.Where(x=>Model.Courses.Any(c=>c.Id==x.CourseId))){var row=Model.Submissions.SingleOrDefault(x=>x.AssignmentId==assignment.Id);<a class="list-card" href="/Demo/Assignment/@assignment.Id?studentId=@Model.Student.Id"><span><strong>@assignment.Title</strong><small>@AssessmentService.SubmissionLabel(assignment,row,DateTime.UtcNow)</small></span><span class="chevron">‹</span></a>}
}
