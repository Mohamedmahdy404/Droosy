@model DemoPage
@{var c=Model.Courses.Single();}
<a class="back-link" href="/Demo/Dashboard?section=courses">→ كل الكورسات</a><section class="course-overview card"><span class="eyebrow">الرياضيات · أ. محمد عادل</span><h2>@c.Title</h2><p>@c.Description</p><div class="course-meta"><span>وحدتان تعليميتان</span><span>@c.MonthlyPrice.ToString("N0") ج.م / شهر</span></div></section><div class="hint-target"><div class="coachmark" data-hint="course" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>@(Model.IsTeacher?"افتح تعديل لإدارة عنوان الدرس ووصفه وحالة النشر، ثم جرّب النتيجة من حساب الطالب.":"الدروس المجانية متاحة للمعاينة. بقية الدروس تحتاج اشتراكًا ساريًا، والمسودات لا تظهر هنا.")</div></div>
@foreach(var unit in c.Units.OrderBy(x=>x.SortOrder)){var lessons=unit.Lessons.Where(x=>Model.IsTeacher||LearningService.IsPublished(x)).OrderBy(x=>x.SortOrder).ToList();<section class="unit-section"><div class="section-title"><h2><span class="unit-number">@unit.SortOrder.ToString("00")</span>@unit.Title</h2><small>@lessons.Count دروس</small></div>@foreach(var l in lessons){var active=Model.Subscriptions.Any(x=>x.CourseId==c.Id&&x.StartsAtUtc<=DateTime.UtcNow&&x.EndsAtUtc>DateTime.UtcNow);var locked=!Model.IsTeacher&&!l.IsPreview&&!active;<article class="lesson-card"><a class="lesson-main" href="/Demo/Lesson/@l.Id"><span class="tile-icon @(locked?"locked":"")"><svg class="icon" aria-hidden="true"><use href="/icons.svg#@(locked?"lock":l.ContentType==LessonContentType.Video?"play":"file")"></use></svg></span><span><strong>@l.Title</strong><small>@(l.ContentType==LessonContentType.Video?"درس فيديو":"درس نصي") · @(l.IsPreview?"معاينة مجانية":"ضمن الاشتراك")</small></span><span class="chevron">‹</span></a>@if(Model.IsTeacher){<div class="lesson-actions"><span class="badge @(l.PublicationStatus==PublicationStatus.Draft?"neutral":l.PublicationStatus==PublicationStatus.Scheduled?"amber":"")">@(l.PublicationStatus==PublicationStatus.Draft?"مسودة":l.PublicationStatus==PublicationStatus.Scheduled?"مجدول":"منشور")</span><a class="text-button" href="/Demo/Edit/@l.Id">تعديل الدرس ✎</a></div>@if(l.PublicationStatus==PublicationStatus.Scheduled){<small class="schedule-note">موعد النشر: @DemoPage.DateAndTime(l.PublishAtUtc!.Value) بتوقيت القاهرة</small>}}</article>}@if(!lessons.Any()){<p class="empty-inline">لا توجد دروس منشورة في هذه الوحدة حتى الآن.</p>}</section>}

