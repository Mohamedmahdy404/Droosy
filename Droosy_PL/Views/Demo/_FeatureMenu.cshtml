@model DemoPage
<div class="profile-card card"><span class="avatar large">@Model.Account!.DisplayName[..1]</span><h2>@Model.Account.DisplayName</h2><p class="muted">@(Model.IsTeacher?"مدرس الرياضيات":Model.IsParent?"ولي أمر أحمد وياسين":"طالب في دروسي")</p><span class="badge">تجربتك مستقلة · بدون كلمة مرور</span></div>
@{var links=new List<(string Url,string Icon,string Title,string Detail)>{("/Demo/Dashboard?section=courses","book","الكورسات والدروس","المحتوى التعليمي والوحدات"),("/Demo/Attendance","calendar","الحضور والغياب","الحصص المعتمدة والتفاصيل"),("/Demo/Progress","chart",Model.IsTeacher?"تقدم الطلاب":"متابعة التعلم","المكتمل وآخر نشاط"),("/Demo/Assignments","clipboard","الواجبات","التسليم والتصحيح"),("/Demo/Exams","file","الاختبارات","المحاولات ونشر النتائج"),("/Demo/Results","chart","النتائج والمراجعة","الدرجات المنشورة وشرح الإجابات"),("/Demo/Messages","message","الرسائل","محادثات بسياق واضح"),("/Demo/Announcements","bell","الإعلانات","آخر المستجدات"),("/Demo/Weekly","chart","التقرير الأسبوعي","أسبوعك من السجلات الفعلية"),("/Demo/Notifications","bell","الإشعارات","التحديثات وحالة القراءة"),("/Demo/Dashboard?section=subscriptions","wallet","الاشتراك","الحالة والمدفوع والمتبقي")};if(Model.IsTeacher){links.Insert(0,("/Demo/Students","users","طلابك","ملف كل طالب"));links.Insert(1,("/Demo/Review","clipboard","بانتظار مراجعتك","التسليمات والنتائج"));}}
@{if(!Model.IsTeacher && !Model.IsParent)links.RemoveAll(link=>link.Url=="/Demo/Progress");}
@foreach(var link in links){@if(link.Url=="/Demo/Review"){<partial name="_ReviewHint" />}<a class="list-card" href="@link.Url"><span class="tile-icon"><svg class="icon"><use href="/icons.svg#@link.Icon"></use></svg></span><span><strong>@link.Title</strong><small>@link.Detail</small></span><span class="chevron">‹</span></a>}
<div class="coachmark" data-hint="switch-role" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>بدّل الدور لتشاهد أثر عملك من منظور آخر. التبديل والتحديث يحتفظان بتغييرات تجربتك.</div><a class="button secondary full" href="/Demo">تبديل الدور ⇄</a>
