@model DemoPage
@{var l=Model.Lesson!;}
<a class="back-link" href="/Demo/Course/@l.Unit.CourseId">→ العودة للكورس</a>
@if(!Model.CanOpen){<section class="empty-state locked-state"><span class="lock-orb"><svg class="icon" aria-hidden="true"><use href="/icons.svg#lock"></use></svg></span><span class="badge amber">يحتاج اشتراكًا ساريًا</span><h2>نكمل الرحلة باشتراك نشط</h2><p>درس «@l.Title» ضمن محتوى الكورس المقيد. تقدر تجرّب الدرس المجاني أو تراجع تفاصيل الاشتراك.</p><a class="button full" href="/Demo/Dashboard?section=subscriptions">عرض الاشتراك</a><a class="text-button" href="/Demo/Course/@l.Unit.CourseId">تصفح دروس المعاينة ←</a></section>}else{<section><div class="lesson-cover"><span aria-hidden="true">@(l.ContentType==LessonContentType.Video?"▷":"▤")</span><p>@l.Unit.Title</p></div><article class="card"><span class="badge">@(l.IsPreview?"معاينة مجانية":"ضمن الاشتراك")</span><h2>@l.Title</h2><p class="lesson-description">@l.Description</p><div class="stage-note"><span>◷</span><p>هذه معاينة للدرس. تشغيل المحتوى الكامل والملزمة وحفظ التقدم سيتاحون قريبًا.</p></div>@if(Model.IsTeacher){<a class="button full" href="/Demo/Edit/@l.Id">تعديل الدرس ✎</a>}</article></section>}
