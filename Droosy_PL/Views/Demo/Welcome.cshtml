@model DemoPage
<section class="welcome"><div class="welcome-kicker"><span></span> مساحة للتعلم، وراحة بال للأهل</div><div class="study-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="notebook"><i></i><i></i><i></i><span>دروسي</span><b>س + ٥ = ١٢</b><div class="paper-lines"></div></div><div class="book-stack"><span></span><span></span><span></span></div><div class="pencil"></div><span class="art-star star-one">✦</span><span class="art-star star-two">✧</span><span class="art-dot"></span></div><p class="eyebrow">أهلًا بك في دروسي</p><h1>كل خطوة في تعلّمه،<br/><em>أنت قريب منها.</em></h1><p class="welcome-copy">تجربة تجمع المدرس والطالب وولي الأمر.<br/>اختر دورك واكتشف رحلة تعليمية مترابطة.</p><div class="role-list">
@foreach(var item in new[]{("P01","♧","أنا ولي أمر","اطمئن على رحلة أحمد وياسين"),("S01","▤","أنا طالب","أحمد محمود · تعلّم خطوة بخطوة"),("T01","✎","أنا مدرس","أ. محمد عادل · مساحة إدارة التعلم")}){<form asp-action="Enter" method="post"><input name="accountId" value="@item.Item1" type="hidden"/><button type="submit" class="role-card @(item.Item1=="P01"?"featured":"")"><span class="role-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#@(item.Item1=="P01"?"users":item.Item1=="T01"?"edit":"book")"></use></svg></span><span><strong>@item.Item3</strong><small>@item.Item4</small></span><span class="role-arrow">←</span></button></form>}
</div><div class="welcome-note"><span>✧</span> بيانات تجريبية · بدون تسجيل أو كلمة مرور</div><details class="test-accounts"><summary>تجربة حساب طالب آخر</summary><p>جرّب زياد أو سليم لمشاهدة الاشتراك المنتهي.</p>@foreach(var u in Droosy_DAL.Seeding.DemoSeedData.Users.Where(x=>x.Role==DemoRole.Student)){<form asp-action="Enter" method="post"><input type="hidden" name="accountId" value="@u.Id"/><button class="text-button" type="submit">@u.Name ←</button></form>}</details></section>
