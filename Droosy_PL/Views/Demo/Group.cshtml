@model DemoPage
@{var g=Model.Groups.Single();}
<a class="back-link" href="/Demo/Dashboard?section=groups">→ المجموعات</a><div class="card"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg></span><h2>@g.Name</h2><p>@g.Course.Level.Name</p><p class="muted">@g.Schedule</p><a class="button secondary full" href="/Demo/Course/@g.CourseId">فتح محتوى المجموعة ←</a></div><div class="section-title"><h2>طلاب المجموعة</h2><span class="badge">@g.Students.Count طلاب</span></div>@foreach(var member in g.Students.OrderBy(x=>x.StudentId)){var s=Model.Subscriptions.FirstOrDefault(x=>x.StudentId==member.StudentId);<div class="list-card"><span class="avatar">@member.Student.DisplayName[..1]</span><span><strong>@member.Student.DisplayName</strong><small>@g.Course.Title</small></span><span class="badge @(s?.EndsAtUtc>DateTime.UtcNow?"":"danger")">@(s?.EndsAtUtc>DateTime.UtcNow?"نشط":"منتهٍ")</span></div>}<div class="stage-note"><span>◷</span><p>تسجيل حضور المجموعة ومتابعته سيتاحان قريبًا.</p></div>
