@model DemoPage
@{var g=Model.Groups.Single();}
<a class="back-link" href="/Demo/Dashboard?section=groups">→ المجموعات</a><div class="card"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg></span><h2>@g.Name</h2><p>@g.Course.Level.Name</p><p class="muted">@g.Schedule</p><a class="button secondary full" href="/Demo/Course/@g.CourseId">فتح محتوى المجموعة ←</a></div><div class="section-title"><h2>حصص المجموعة</h2><a href="/Demo/Attendance">عرض الكل ←</a></div>@foreach(var session in Model.Sessions.Where(x=>x.GroupId==g.Id).OrderByDescending(x=>x.StartsAtUtc)){<a class="list-card" href="/Demo/Session/@session.Id"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg></span><span><strong>@session.Title</strong><small>@DemoPage.DateAndTime(session.StartsAtUtc)</small></span><span class="badge @(session.IsApproved?"":"amber")">@(session.EndsAtUtc>DateTime.UtcNow?"قادمة":session.IsApproved?"معتمدة":"مسودة")</span></a>}<div class="section-title"><h2>طلاب المجموعة</h2><span class="badge">@g.Students.Count طلاب</span></div>@foreach(var member in g.Students.OrderBy(x=>x.StudentId)){var s=Model.Subscriptions.FirstOrDefault(x=>x.StudentId==member.StudentId);<div class="list-card"><span class="avatar">@member.Student.DisplayName[..1]</span><span><strong>@member.Student.DisplayName</strong><small>@g.Course.Title</small>@if(Model.IsTeacher){<a class="text-button" href="/Demo/Progress?studentId=@member.StudentId">عرض تقدم الطالب ←</a>}</span><span class="badge @(s?.EndsAtUtc>DateTime.UtcNow?"":"danger")">@(s?.EndsAtUtc>DateTime.UtcNow?"نشط":"منتهٍ")</span></div>}<div class="stage-note"><span>◷</span><p>حضور الحصص منفصل عن تقدم مشاهدة الدروس؛ راجع كل مسار من صفحته.</p></div>
