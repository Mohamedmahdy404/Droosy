@model DemoPage
@foreach(var c in Model.Courses){var count=c.Units.SelectMany(x=>x.Lessons).Count(x=>Model.IsTeacher||LearningService.IsPublished(x));<a class="course-card card" href="/Demo/Course/@c.Id"><div class="course-cover @(c.Id=="GEO"?"geometry":"")"><span class="badge">@c.Level.Name</span><span class="course-formula" aria-hidden="true">@(c.Id=="ALG"?"𝑥 + ٥ = ١٢":"△")</span><span class="cover-dot"></span></div><div class="course-info"><span class="eyebrow">الرياضيات · أ. محمد عادل</span><h2>@c.Title</h2><p>@c.Description</p><div class="course-meta"><span>▤ @count دروس</span><span>وحدتان</span><strong>استكشف الكورس ←</strong></div></div></a>}
@if(!Model.Courses.Any()){<div class="empty-state"><h2>لا توجد كورسات بعد</h2><p>الكورسات المسجل بها الطالب هتظهر هنا.</p></div>}
