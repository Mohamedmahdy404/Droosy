@model DemoPage
@if(Model.IsTeacher){<details class="card announcement-editor"><summary>إعلان جديد +</summary><form asp-antiforgery="false" asp-action="PublishAnnouncement" method="post"><input type="hidden" name="clientId" value="@Guid.NewGuid()"/><div class="field"><label for="announcement-title">العنوان</label><input name="title" id="announcement-title" maxlength="160" required/></div><div class="field"><label for="announcement-body">نص الإعلان</label><textarea name="body" id="announcement-body" rows="4" maxlength="2000" required></textarea></div><div class="field"><label for="announcement-group">يظهر لمن؟</label><select id="announcement-group" name="groupId"><option value="">كل الطلاب والأهل</option>@foreach(var group in Model.Groups){<option value="@group.Id">@group.Name</option>}</select></div><button type="submit" class="button full">نشر الإعلان</button></form></details>}
@foreach(var announcement in Model.Announcements){<article class="card announcement-card"><div class="card-top"><span class="badge">@(announcement.GroupId==null?"إعلان عام":Model.Groups.Single(x=>x.Id==announcement.GroupId).Name)</span><small>@DemoPage.Date(announcement.PublishedAtUtc)</small></div><h2>@announcement.Title</h2><p>@announcement.Body</p>@if(announcement.TargetUrl!="/Demo/Announcements"){<a class="text-button" href="@announcement.TargetUrl">@(announcement.TargetUrl.Contains("/Exam/")?"فتح الاختبار":announcement.TargetUrl.Contains("/Assignment/")?"فتح الواجب":"العودة للرئيسية") ←</a>}</article>}
@if(!Model.Announcements.Any()){<section class="empty-state"><h2>لا توجد إعلانات الآن</h2><p>كل جديد يخصك سيظهر هنا.</p></section>}

