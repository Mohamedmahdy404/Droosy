@model DemoPage
@{var now=DateTime.UtcNow;var courseExams=Model.Exams.ToList();if(ViewData.ModelState.IsValid){courseExams=courseExams.Where(e=>{var day=DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.OpensAtUtc,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("Egypt Standard Time")));return (!Model.From.HasValue||day>=Model.From)&&(!Model.To.HasValue||day<=Model.To);}).ToList();}}
@if(Model.IsTeacher){<form asp-antiforgery="false" asp-action="Results" method="get" class="student-select card"><label for="result-student">اختر الطالب</label><select id="result-student" name="studentId">@foreach(var student in Model.Students){<option value="@student.Id" selected="@(student.Id==Model.Student?.Id)">@student.DisplayName</option>}</select><button class="button secondary full" type="submit">عرض النتائج</button></form>}
<div class="coachmark" data-hint="results" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>تظهر الدرجات بعد النشر فقط. الصفر نتيجة فعلية، و«لم يدخل» تظهر مستقلة. اختر فترة حسب تاريخ الاختبار.</div>
<form asp-antiforgery="false" asp-action="Results" method="get" class="date-filter card">@if(Model.IsTeacher){<input type="hidden" name="studentId" value="@Model.Student?.Id"/>}<div asp-validation-summary="All" class="validation" role="alert"></div><div class="date-fields"><label>من تاريخ الاختبار<input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")"/></label><label>إلى تاريخ الاختبار<input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")"/></label></div><button class="button full" type="submit">عرض النتائج</button></form>
@foreach(var course in Model.Courses)
{
 var trend=courseExams.Where(e=>e.CourseId==course.Id&&(e.ClosesAtUtc<now||Model.Attempts.Any(a=>a.ExamId==e.Id&&a.StudentId==Model.Student?.Id&&a.PublishedAtUtc!=null))).OrderBy(x=>x.OpensAtUtc).ToList();
 @if(trend.Count>0){<figure class="card results-chart"><figcaption><strong>تطور نتائج @Model.Student!.DisplayName.Split(' ')[0]</strong><small>@course.Title · درجات منشورة من ١٠</small></figcaption><div class="chart-frame"><div class="chart-axis"><span>10</span><span>5</span><span>0</span></div><svg viewBox="0 0 320 160" role="img" aria-label="درجات منشورة؛ الفجوة تعني عدم وجود نتيجة منشورة"><path d="M20 20H300M20 80H300M20 140H300" stroke="#dddcce" stroke-width="1" fill="none"/>
 @for(var i=0;i<trend.Count;i++) {var attempt=Model.Attempts.SingleOrDefault(a=>a.ExamId==trend[i].Id&&a.StudentId==Model.Student.Id);var value=attempt?.PublishedAtUtc!=null?attempt.Score:null;var x=trend.Count==1?160:20+i*280/(trend.Count-1);if(value.HasValue){var y=140-value.Value*12;if(i>0){var previous=Model.Attempts.SingleOrDefault(a=>a.ExamId==trend[i-1].Id&&a.StudentId==Model.Student.Id);if(previous?.PublishedAtUtc!=null&&previous.Score.HasValue){var px=20+(i-1)*280/(trend.Count-1);var py=140-previous.Score.Value*12;<line x1="@px" y1="@py" x2="@x" y2="@y" stroke="#0e5a46" stroke-width="3"/>}}<circle cx="@x" cy="@y" r="5" fill="#0e5a46"><title>@trend[i].Title: @value / 10</title></circle>}else{<circle cx="@x" cy="140" r="5" stroke="#ad883f" stroke-width="2" stroke-dasharray="2 2" fill="#fffef9"><title>لا توجد نتيجة منشورة</title></circle>}}</svg></div><div class="chart-labels">@foreach(var item in trend){<span>@item.Id.Split('-')[1]</span>}</div><p>الدرجات للمهارات نفسها وبنفس الدرجة النهائية. الاتجاه لا يثبت الفهم وحده.</p></figure>}
}
@foreach(var exam in courseExams.OrderByDescending(x=>x.OpensAtUtc))
{
 var attempt=Model.Attempts.SingleOrDefault(x=>x.ExamId==exam.Id&&x.StudentId==Model.Student?.Id);var published=attempt?.PublishedAtUtc!=null;var status=exam.OpensAtUtc>now?"قادم":published?"منشورة":attempt?.SubmittedAtUtc!=null?"بانتظار النشر":attempt!=null?"قيد الحل":exam.ClosesAtUtc<now?"لم يدخل":"متاح للطالب";
 <a class="card result-row" href="/Demo/Exam/@exam.Id@(Model.IsTeacher?"?studentId="+Model.Student?.Id:"")"><div><span class="eyebrow">@DemoPage.Date(exam.OpensAtUtc)</span><h2>@exam.Title</h2><span class="badge @(status=="لم يدخل"?"amber":"neutral")">@status</span></div><div class="result-value">@if(published){<strong>@attempt!.Score<small>/ @exam.Questions.Sum(x=>x.Points)</small></strong>}else{<span>—</span>}</div></a>
}
@if(!courseExams.Any()){<section class="empty-state"><h2>لا توجد اختبارات في هذه الفترة</h2><p>جرّب تغيير تاريخ البداية والنهاية.</p></section>}

