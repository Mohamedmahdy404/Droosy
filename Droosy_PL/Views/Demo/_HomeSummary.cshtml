@model DemoPage
@{var now=DateTime.UtcNow;var lessons=Model.Courses.SelectMany(x=>x.Units).SelectMany(x=>x.Lessons).Where(LearningService.IsPublished).ToList();var completed=lessons.Count(l=>Model.ProgressRows.Any(p=>p.StudentId==Model.Student?.Id&&p.LessonId==l.Id&&p.IsCompleted));var pendingWork=Model.Assignments.Count(a=>!Model.Submissions.Any(s=>s.AssignmentId==a.Id&&s.StudentId==Model.Student?.Id&&s.Status is not (SubmissionStatus.Draft or SubmissionStatus.Returned)));}
<section class="feature-banner"><div><span class="banner-tag">@(Model.IsTeacher?"مساحتك التعليمية":Model.IsParent?"متابعة تصنع فرقًا":"كل يوم، خطوة جديدة")</span><h2>@(Model.IsTeacher?"تعليم منظم، وأثر واضح.":Model.IsParent?"كل خطوة لـ"+Model.Student!.DisplayName.Split(' ')[0]+"، أنت قريب منها.":"جاهز نكمل رحلتنا؟")</h2><p>@(Model.IsTeacher?"محتواك ومجموعاتك ومراجعاتك بين يديك.":Model.IsParent?"حضوره، وتعلمه، ونتائجه في صورة واحدة.":"دروس وواجبات واختبارات، على مهلك وبخطوات واضحة.")</p><a class="banner-link" href="@(Model.IsTeacher?"/Demo/Review":"/Demo/Progress")">@(Model.IsTeacher?"بانتظار مراجعتك":"شاهد رحلة التعلم") ←</a></div><span class="banner-illustration" aria-hidden="true">▤<i>✦</i></span></section>
@if(Model.IsTeacher)
{
 var unread=Model.Conversations.Count(c=>c.Messages.Any(m=>m.SenderId!=Model.Account!.Id&&m.ReadAtUtc==null));
 <div class="stats-grid"><a class="stat" href="/Demo/Students"><strong>@Model.Students.Count</strong><span>طلابك</span></a><a class="stat" href="/Demo/Review"><strong>@(Model.PendingAssignments+Model.PendingExams)</strong><span>بانتظار مراجعتك</span></a><a class="stat" href="/Demo/Messages?unread=true"><strong>@unread</strong><span>محادثات غير مقروءة</span></a></div><div class="quick-links"><a class="quick-link" href="/Demo/Attendance"><svg class="icon"><use href="/icons.svg#calendar"></use></svg><strong>الحصص والحضور</strong><small>سجّل واعتمد الحضور</small></a><a class="quick-link" href="/Demo/Dashboard?section=courses"><svg class="icon"><use href="/icons.svg#book"></use></svg><strong>المحتوى التعليمي</strong><small>الدروس والنشر</small></a><a class="quick-link" href="/Demo/Assignments"><strong>الواجبات والتصحيح</strong><small>@Model.PendingAssignments تحتاج مراجعة</small></a><a class="quick-link" href="/Demo/Exams"><strong>الاختبارات والنتائج</strong><small>@Model.PendingExams نتائج تنتظر النشر</small></a></div>
 <div class="section-title"><h2>مجموعاتك</h2><a href="/Demo/Dashboard?section=groups">عرض الكل ←</a></div>@foreach(var group in Model.Groups){<a class="list-card" href="/Demo/Group/@group.Id"><span class="tile-icon"><svg class="icon"><use href="/icons.svg#users"></use></svg></span><span><strong>@group.Name</strong><small>@group.Course.Level.Name · @group.Students.Count طلاب</small></span><span class="chevron">‹</span></a>}
}
else
{
 <div class="stats-grid"><a class="stat" href="/Demo/Progress"><strong>@completed</strong><span>دروس مكتملة</span></a><a class="stat" href="/Demo/Assignments?pending=true"><strong>@pendingWork</strong><span>واجبات لم تُسلّم</span></a><a class="stat" href="/Demo/Results"><strong>@Model.Attempts.Count(x=>x.StudentId==Model.Student?.Id&&x.PublishedAtUtc!=null)</strong><span>نتائج منشورة</span></a></div>
 @if(Model.Attention.Any()){<div class="section-title"><h2>يحتاج متابعتك</h2><small>@Model.Attention.Count نقاط واضحة</small></div>@foreach(var item in Model.Attention){<a class="attention-card @item.Tone" href="@item.Url"><span class="attention-dot"></span><span><strong>@item.Title</strong><small>@item.Detail</small></span><span>‹</span></a>}}
 @await Html.PartialAsync("_TrackingLinks",Model)
 <div class="section-title"><h2>المسار التعليمي</h2><a href="/Demo/Dashboard?section=courses">كل الدروس ←</a></div>@await Html.PartialAsync("_Courses",Model)
 <div class="quick-links"><a class="quick-link" href="/Demo/Weekly"><svg class="icon"><use href="/icons.svg#chart"></use></svg><strong>التقرير الأسبوعي</strong><small>آخر ٧ أيام في صورة واحدة</small></a><a class="quick-link" href="/Demo/Messages"><svg class="icon"><use href="/icons.svg#message"></use></svg><strong>تواصل مع المدرس</strong><small>@Model.UnreadMessages رسائل غير مقروءة</small></a></div>
}
<div class="section-title"><h2>آخر الإعلانات</h2><a href="/Demo/Announcements">عرض الكل ←</a></div>@foreach(var announcement in Model.Announcements.Take(2)){<a class="card announcement-card" href="@announcement.TargetUrl"><span class="eyebrow">@DemoPage.Date(announcement.PublishedAtUtc)</span><h2>@announcement.Title</h2><p>@announcement.Body</p></a>}
