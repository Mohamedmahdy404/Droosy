@model DemoPage
@{var from=Model.WeekFromUtc;var until=Model.WeekToUtc;var sessions=Model.Sessions.Where(s=>s.IsApproved&&s.EndsAtUtc>=from&&s.EndsAtUtc<=until).ToList();var attendance=sessions.SelectMany(s=>s.Attendances).Where(x=>Model.IsTeacher||x.StudentId==Model.Student!.Id).ToList();var activity=Model.ProgressRows.Where(x=>x.LastOpenedAtUtc>=from&&x.LastOpenedAtUtc<=until&&(Model.IsTeacher||x.StudentId==Model.Student!.Id)).ToList();var completed=Model.ProgressRows.Count(x=>x.IsCompleted&&x.CompletedAtUtc>=from&&x.CompletedAtUtc<=until&&(Model.IsTeacher||x.StudentId==Model.Student!.Id));var submissions=Model.Submissions.Where(x=>x.Status!=SubmissionStatus.Draft&&x.SubmittedAtUtc>=from&&x.SubmittedAtUtc<=until).ToList();var results=Model.Attempts.Where(x=>x.PublishedAtUtc>=from&&x.PublishedAtUtc<=until).ToList();}
<section class="learning-summary"><div><span class="eyebrow">@(Model.IsTeacher?"طلابك هذا الأسبوع":Model.Student!.DisplayName)</span><h2>كل خطوة لها أثر.</h2><p>@DemoPage.Date(from) — @DemoPage.Date(until)</p></div><span class="week-symbol">٧<small>أيام</small></span><p class="summary-footnote">الحضور المعتمد والنشاط والنتائج المنشورة خلال الفترة.</p></section>
<form asp-antiforgery="false" asp-action="Weekly" method="get" class="card"><div class="field"><label for="week-until">الأسبوع المنتهي في</label><input type="date" name="until" id="week-until" value="@Model.To?.ToString("yyyy-MM-dd")"/></div><button class="button secondary full" type="submit">عرض الأسبوع</button></form>
<div class="stats-grid"><div class="stat"><strong>@attendance.Count</strong><span>سجلات حضور معتمدة</span></div><div class="stat"><strong>@completed</strong><span>دروس أُكملت</span></div><div class="stat"><strong>@results.Count</strong><span>نتائج نُشرت</span></div></div>
<section class="card weekly-section"><h2>الحضور خلال الأسبوع</h2><div class="attendance-stats">@foreach(var status in Enum.GetValues<AttendanceStatus>()){<div class="@TrackingDisplay.Tone(status)"><strong>@attendance.Count(x=>x.PublishedStatus==status)</strong><span>@TrackingDisplay.Status(status)</span></div>}</div>@if(attendance.Count==0){<p class="muted">لا توجد حصص معتمدة في الفترة.</p>}</section>
<section class="card weekly-section"><h2>التعلم والنشاط</h2><p>@activity.Count سجلات دروس بها آخر نشاط خلال الفترة. وأُكمل @completed دروس خلالها.</p><p class="muted">هذا وصف للنشاط المسجل، ولا يقيس الفهم.</p></section>
<section class="card weekly-section"><h2>الواجبات التي سُلّمت</h2>@foreach(var row in submissions){var assignment=Model.Assignments.Single(x=>x.Id==row.AssignmentId);<a class="weekly-row" href="/Demo/Assignment/@row.AssignmentId@(Model.IsTeacher?"?studentId="+row.StudentId:"")"><span><strong>@assignment.Title</strong>@if(Model.IsTeacher){<small>@row.Student.DisplayName</small>}</span><span class="badge @(row.SubmittedAtUtc>assignment.DueAtUtc?"amber":"")">@(row.SubmittedAtUtc>assignment.DueAtUtc?"متأخر":"تم التسليم")</span></a>}@if(submissions.Count==0){<p class="muted">لا توجد تسليمات خلال الفترة.</p>}</section>
<section class="card weekly-section"><h2>نتائج نُشرت خلال الأسبوع</h2>@foreach(var attempt in results){<a class="weekly-row" href="/Demo/Exam/@attempt.ExamId@(Model.IsTeacher?"?studentId="+attempt.StudentId:"")"><span><strong>@attempt.Exam.Title</strong><small>نُشرت @DemoPage.Date(attempt.PublishedAtUtc!.Value)</small></span><strong>@attempt.Score / @attempt.Exam.Questions.Sum(x=>x.Points)</strong></a>}@if(results.Count==0){<p class="muted">لا توجد نتائج منشورة في هذه الفترة.</p>}</section>
@if(Model.Attention.Any()){<div class="section-title"><h2>خطوة متابعة مقترحة</h2></div>@foreach(var item in Model.Attention.Take(3)){<a class="attention-card @item.Tone" href="@item.Url"><span><strong>@item.Title</strong><small>@item.Detail</small></span><span>‹</span></a>}}


