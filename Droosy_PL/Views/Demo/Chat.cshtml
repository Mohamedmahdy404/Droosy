@model ChatPageModel
@{var used=(long?)(ViewData["ChatUsedBytes"])??0;var remaining=Math.Max(0,Droosy_PL.Services.UploadStore.ChatQuotaBytes-used);var conversation=Model.Conversation;var contextUrl=conversation.ContextType==ConversationContext.Assignment?"/Demo/Assignment/":conversation.ContextType==ConversationContext.Exam?"/Demo/Exam/":"/Demo/Lesson/";}
<a class="back-link" href="/Demo/Messages">→ الرسائل</a>
<a class="chat-context card" href="@(contextUrl+conversation.ContextId+(Model.Page.IsTeacher&&conversation.ContextType!=ConversationContext.Lesson?"?studentId="+conversation.StudentId:""))"><span class="tile-icon"><svg class="icon"><use href="/icons.svg#file"></use></svg></span><div><span class="eyebrow">بخصوص @conversation.Student.DisplayName</span><strong>@Model.ContextTitle</strong></div><span class="chevron">‹</span></a>
<div class="chat-thread" aria-label="رسائل المحادثة">@foreach(var message in conversation.Messages.OrderBy(x=>x.SentAtUtc)){var mine=message.SenderId==Model.Page.Account!.Id;<article class="chat-bubble @(mine?"mine":"")"><span class="chat-sender">@message.Sender.DisplayName</span>@if(!string.IsNullOrWhiteSpace(message.Text)){<p dir="auto" translate="@(message.Id.Contains("-M",StringComparison.Ordinal)?"yes":"no")">@message.Text</p>}@if(message.AttachmentPath!=null){<a class="chat-attachment" href="/Demo/MessageAttachment/@message.Id" target="_blank" rel="noopener"><svg class="icon"><use href="/icons.svg#attach"></use></svg><span>@message.AttachmentName<small>فتح المرفق ↗</small></span></a>}<small class="chat-time">@DemoPage.DateAndTime(message.SentAtUtc) @if(mine){<span>@(message.ReadAtUtc!=null?"✓✓ مقروءة":"✓ أُرسلت")</span>}</small></article>}</div>
<form asp-antiforgery="false" asp-action="SendMessage" asp-route-id="@conversation.Id" method="post" enctype="multipart/form-data" class="message-compose card"><input type="hidden" name="clientMessageId" value="@Model.ClientMessageId"/><label for="message-text" class="sr-only">نص الرسالة</label><textarea id="message-text" name="text" rows="3" maxlength="2000" placeholder="اكتب رسالتك..." data-message-text></textarea><div class="compose-toolbar"><label class="attach-button"><svg class="icon"><use href="/icons.svg#attach"></use></svg><span>مرفق</span><input type="file" name="attachment" accept="image/png,image/jpeg,application/pdf" data-message-file data-remaining-bytes="@remaining"/><small class="sr-only">صورة أو PDF حتى 2 MB</small></label><button type="submit" class="button">إرسال <svg class="icon"><use href="/icons.svg#send"></use></svg></button></div><p class="chat-storage" data-chat-storage><span>مساحة مرفقات التجربة</span><strong dir="ltr">@((used/1048576d).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)) / 10 MB</strong></p><span class="chosen-file" data-file-label translate="no"></span><p class="muted">صورة أو PDF حتى 2 MB.</p></form>
@section Scripts{<script src="~/js/message-compose.js" asp-append-version="true" defer></script>}

