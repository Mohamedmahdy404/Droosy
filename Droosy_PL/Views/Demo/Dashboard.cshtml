@model DemoPage
@if(Model.Section=="home"){
<div class="hint-target"><div class="coachmark" data-hint="home" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>@(Model.IsParent?"بدّل بين أحمد وياسين من أعلى الصفحة؛ كل ابن له كورسه واشتراكه.":Model.IsTeacher?"ابدأ بالمحتوى لتعديل الدروس ونشرها، أو افتح المجموعات لعرض طلابك.":"ابدأ بكورساتك لعرض الدروس. تقدر تبدّل الدور من أعلى الصفحة في أي وقت.")</div></div><section class="feature-banner"><div><span class="banner-tag">@(Model.IsTeacher?"مساحتك التعليمية":Model.IsParent?"متابعة تصنع فرقًا":"كل يوم، خطوة جديدة")</span><h2>@(Model.IsTeacher?"تعليم منظم، وأثر واضح.":Model.IsParent?"رحلة "+Model.Student!.DisplayName.Split(' ')[0]+" تبدأ من هنا.":"جاهز نكمل رحلتنا؟")</h2><p>@(Model.IsTeacher?"محتواك ومجموعاتك بين يديك.":Model.IsParent?"تصفح دروسه وتابع تفاصيل اشتراكه.":"دروس مرتبة تساعدك تفهم، على مهلك.")</p><a class="banner-link" href="/Demo/Dashboard?section=courses">@(Model.IsTeacher?"إدارة المحتوى":"استكشف الدروس") ←</a></div><span class="banner-illustration" aria-hidden="true">▤<i>✦</i></span></section>
<div class="stats-grid"><div class="stat"><strong>@(Model.IsTeacher?Model.Students.Count:Model.Courses.Count)</strong><span>@(Model.IsTeacher?"طلاب في مجموعاتك":"كورس مسجل")</span></div><div class="stat"><strong>@(Model.IsTeacher?Model.Courses.Count:Model.Courses.SelectMany(x=>x.Units).SelectMany(x=>x.Lessons).Count(LearningService.IsPublished))</strong><span>@(Model.IsTeacher?"كورسات تعليمية":"دروس منشورة")</span></div><div class="stat"><strong>@(Model.IsTeacher?Model.Groups.Count:Model.Subscriptions.Count(x=>x.StartsAtUtc<=DateTime.UtcNow&&x.EndsAtUtc>DateTime.UtcNow))</strong><span>@(Model.IsTeacher?"مجموعات":"اشتراك نشط")</span></div></div>
<div class="section-title"><h2>@(Model.IsTeacher?"مجموعاتك":"المسار التعليمي")</h2><a href="/Demo/Dashboard?section=@(Model.IsTeacher?"groups":"courses")">عرض الكل ←</a></div>
@if(Model.IsTeacher){foreach(var g in Model.Groups){<a class="list-card" href="/Demo/Group/@g.Id"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg></span><span><strong>@g.Name</strong><small>@g.Course.Level.Name · @g.Students.Count طلاب</small></span><span class="chevron">‹</span></a>}}else{@await Html.PartialAsync("_Courses",Model)}
<div class="section-title"><h2>لمحة عن الاشتراكات</h2><a href="/Demo/Dashboard?section=subscriptions">التفاصيل ←</a></div>
@if(Model.IsTeacher){<div class="card"><div class="money-row"><span>إجمالي أسعار الاشتراكات</span><strong>@Model.Subscriptions.Sum(x=>x.Price).ToString("N0") ج.م</strong></div><div class="money-row"><span>المدفوع</span><strong>@Model.Subscriptions.Sum(x=>x.Payments.Sum(p=>p.Amount)).ToString("N0") ج.م</strong></div><p class="muted">تشمل هذه الإجماليات الاشتراكات المنتهية.</p></div>}else{foreach(var s in Model.Subscriptions){<a class="subscription-summary" href="/Demo/Dashboard?section=subscriptions"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#wallet"></use></svg></span><div><strong>@s.Course.Title</strong><small>ينتهي في @DemoPage.Date(s.EndsAtUtc)</small></div><span class="badge @(s.EndsAtUtc>DateTime.UtcNow?"":"danger")">@(s.EndsAtUtc>DateTime.UtcNow?"نشط":"منتهٍ")</span></a>}}
<div class="stage-note"><span>◷</span><p>قريبًا: الحضور والواجبات والنتائج والتواصل في نفس التجربة.</p></div>
}else if(Model.Section=="courses"){
<p class="intro-note">@(Model.IsTeacher?"عدّل دروسك وانشرها، وشاهد التغيير من حساب الطالب.":"دروس مرتبة، وخطوات واضحة في رحلتك التعليمية.")</p>@await Html.PartialAsync("_Courses",Model)
}else if(Model.Section=="groups"){
@foreach(var g in Model.Groups){<a class="group-card card" href="/Demo/Group/@g.Id"><div class="card-top"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#users"></use></svg></span><span class="badge">@g.Students.Count طلاب</span></div><h2>@g.Name</h2><p>@g.Course.Level.Name</p><div class="card-divider"></div><small>◷ @g.Schedule</small><div class="group-avatars">@foreach(var s in g.Students){<span class="avatar">@s.Student.DisplayName[..1]</span>}<span class="group-open">فتح المجموعة ←</span></div></a>}
}else if(Model.Section=="subscriptions"){
<p class="intro-note">تفاصيل الاشتراك والمدفوعات المسجلة. الدفع والتفعيل غير متاحين في هذا الجزء من التجربة.</p>
@foreach(var s in Model.Subscriptions){var paid=s.Payments.Sum(x=>x.Amount);var active=s.StartsAtUtc<=DateTime.UtcNow&&s.EndsAtUtc>DateTime.UtcNow;<article class="card"><div class="card-top"><span class="eyebrow">@(Model.IsTeacher?s.Student.DisplayName:s.Course.Title)</span><span class="badge @(!active?"danger":"")">@(active?"اشتراك نشط":"اشتراك منتهٍ")</span></div><h2>@s.Course.Title</h2><p class="muted">@DemoPage.Date(s.StartsAtUtc) — @DemoPage.Date(s.EndsAtUtc)</p><div class="money-grid"><div><small>السعر</small><strong>@s.Price.ToString("N0")<em>ج.م</em></strong></div><div><small>المدفوع</small><strong>@paid.ToString("N0")<em>ج.م</em></strong></div><div><small>المتبقي</small><strong>@((s.Price-paid).ToString("N0"))<em>ج.م</em></strong></div></div>@foreach(var payment in s.Payments){<div class="payment-row"><span>✓ @payment.Method<small>@DemoPage.Date(payment.PaidAtUtc)</small></span><strong>@payment.Amount.ToString("N0") ج.م</strong></div>}@if(!s.Payments.Any()){<p class="empty-inline">لم تُسجل دفعات لهذا الاشتراك.</p>}</article>}
@if(Model.IsTeacher){<h2 class="section-heading">أكواد التجربة</h2>@foreach(var code in Model.Codes){<div class="card"><b class="code" dir="ltr">@code.Code</b><p>@code.Value.ToString("N0") ج.م · @(code.RedeemedAtUtc!=null?"مستخدم":code.ExpiresAtUtc<DateTime.UtcNow?"منتهي":"صالح غير مستخدم")</p></div>}}
}else{
<div class="profile-card card"><span class="avatar large">@Model.Account!.DisplayName[..1]</span><h2>@Model.Account.DisplayName</h2><p class="muted">@(Model.IsTeacher?"مدرس الرياضيات":Model.IsParent?"ولي أمر أحمد وياسين":"طالب في دروسي")</p><span class="badge">حساب تجريبي بدون كلمة مرور</span></div><a class="list-card" href="/Demo/Dashboard?section=courses"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#book"></use></svg></span><span><strong>الكورسات والدروس</strong><small>المحتوى التعليمي والوحدات</small></span><span class="chevron">‹</span></a><a class="list-card" href="/Demo/Dashboard?section=subscriptions"><span class="tile-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#wallet"></use></svg></span><span><strong>الاشتراكات</strong><small>الحالة والمدفوعات والمتبقي</small></span><span class="chevron">‹</span></a><div class="hint-target"><div class="coachmark" data-hint="switch" role="note"><button type="button" data-dismiss aria-label="إغلاق الشرح">×</button>بدّل الدور لتشاهد نفس البيانات من منظور آخر. تغييراتك تفضل محفوظة.</div><a class="button secondary full" href="/Demo">تبديل الدور التجريبي ⇄</a></div><div class="stage-note"><span>◷</span><p>الحضور والمهام والرسائل ستظهر هنا قريبًا.</p></div>
}
