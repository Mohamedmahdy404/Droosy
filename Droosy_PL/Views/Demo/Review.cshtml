@model DemoPage
<div class="stats-grid"><div class="stat"><strong>@Model.PendingAssignments</strong><span>واجبات تحتاج مراجعة</span></div><div class="stat"><strong>@Model.PendingExams</strong><span>نتائج تنتظر النشر</span></div><div class="stat"><strong>@(Model.PendingAssignments+Model.PendingExams)</strong><span>إجمالي المتابعة</span></div></div>
<div class="section-title"><h2>التسليمات</h2></div>@foreach(var row in Model.Submissions.Where(DemoPage.NeedsReview)){var assignment=Model.Assignments.Single(x=>x.Id==row.AssignmentId);<a class="list-card" href="/Demo/Assignment/@row.AssignmentId?studentId=@row.StudentId"><span class="avatar">@row.Student.DisplayName[..1]</span><span><strong>@row.Student.DisplayName</strong><small>@assignment.Title · @(row.Status==SubmissionStatus.Submitted?"بانتظار التصحيح":"تصحيح لم يُنشر")</small></span><span class="chevron">‹</span></a>}
<div class="section-title"><h2>نتائج الاختبارات</h2></div>@foreach(var attempt in Model.Attempts.Where(x=>x.SubmittedAtUtc!=null&&x.PublishedAtUtc==null)){<a class="list-card" href="/Demo/Exam/@attempt.ExamId?studentId=@attempt.StudentId"><span class="avatar">@attempt.Student.DisplayName[..1]</span><span><strong>@attempt.Student.DisplayName</strong><small>@attempt.Exam.Title · @attempt.Score / @attempt.Exam.Questions.Sum(x=>x.Points)</small></span><span class="chevron">‹</span></a>}
@if(Model.PendingAssignments+Model.PendingExams==0){<section class="empty-state"><h2>كل شيء مراجع ✓</h2><p>لا توجد تسليمات أو نتائج تنتظر خطوتك الآن.</p></section>}
