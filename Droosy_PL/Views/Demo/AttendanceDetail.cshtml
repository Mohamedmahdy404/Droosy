@model DemoPage
@{ var session = Model.SelectedSession!; var row = session.Attendances.Single(x => x.StudentId == Model.Student!.Id); }
<a class="back-link" href="/Demo/Attendance">→ سجل الحضور</a>
<section class="attendance-detail card"><span class="detail-orb @TrackingDisplay.Tone(row.PublishedStatus)"><svg class="icon" aria-hidden="true"><use href="/icons.svg#calendar"></use></svg></span><span class="badge @TrackingDisplay.Tone(row.PublishedStatus)">@TrackingDisplay.Status(row.PublishedStatus)</span><h2>@Model.Student!.DisplayName</h2><p>@session.Title</p><div class="detail-facts"><div><span>المجموعة</span><strong>@session.Group.Name</strong></div><div><span>موعد الحصة</span><strong>@DemoPage.DateAndTime(session.StartsAtUtc)</strong></div><div><span>انتهاء الحصة</span><strong>@DemoPage.DateAndTime(session.EndsAtUtc)</strong></div><div><span>آخر اعتماد</span><strong>@DemoPage.DateAndTime(session.ApprovedAtUtc!.Value)</strong></div></div>
@if (!string.IsNullOrWhiteSpace(row.PublishedNote)) { <div class="teacher-note"><span class="eyebrow">ملاحظة المدرس</span><p>@row.PublishedNote</p></div> }
<p class="muted">كل المواعيد بتوقيت القاهرة. هذه حالة حضور الحصة، ومستقلة عن مشاهدة الدروس.</p></section>
<a class="button secondary full" href="/Demo/Progress">متابعة الدروس ←</a>
